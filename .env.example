GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_ASSISTANT_SECRET=your_internal_secret

KNOWLEDGE_BASE_DIR=dataset

AI_MAX_INPUT_CHARS=1200
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_MEMORIES_IN_CONTEXT=5

AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_HOUR=30

AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_SERVER_QUEUE=2

AI_MOCK_MODE=true